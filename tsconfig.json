{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "packages", "outDir": "dist", "strict": true,
    "esModuleInterop": true, "declaration": true, "skipLibCheck": true,
    "resolveJsonModule": true, "noUncheckedIndexedAccess": true
  },
  "include": ["packages/**/*.ts"]
}
