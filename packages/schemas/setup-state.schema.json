{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "createdAt", "updatedAt", "files", "changedFiles", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "workflowVersion": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "files": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "changedFiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "dependsOn", "inputs", "outputs", "status", "updatedAt"],
        "properties": {
          "skill": {"type": "string", "pattern": "^astrofy-[a-z0-9-]+$"},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^astrofy-[a-z0-9-]+$"}},
          "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["completed", "pending", "not_applicable"]},
          "updatedAt": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "runs": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["startedAt", "completedAt", "durationMs", "resumed", "changedFiles"], "properties": {"startedAt": {"type": "string", "format": "date-time"}, "completedAt": {"type": "string", "format": "date-time"}, "durationMs": {"type": "integer", "minimum": 0}, "resumed": {"type": "boolean"}, "changedFiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}
  }
}
