{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrofy.promovaweb.com/schemas/1.0.0/checklist",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "project",
                  "page",
                  "component",
                  "collection"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "target"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "error",
              "warning",
              "info"
            ]
          },
          "method": {
            "enum": [
              "automatic",
              "manual",
              "hybrid"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "blocked",
              "not_applicable"
            ]
          },
          "checkedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "inputFingerprint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "verifier": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "result": {
                  "type": "string",
                  "minLength": 1
                },
                "environment": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "report": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "verifier",
                "version",
                "runId",
                "checkedAt",
                "inputs",
                "result",
                "environment",
                "report"
              ]
            }
          },
          "reason": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "passed",
                    "failed",
                    "blocked",
                    "not_applicable"
                  ]
                },
                "checkedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "inputFingerprint": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "verifier": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "pattern": "^\\d+\\.\\d+\\.\\d+$"
                      },
                      "runId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "checkedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "inputs": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "result": {
                        "type": "string",
                        "minLength": 1
                      },
                      "environment": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "report": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reviewer": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "verifier",
                      "version",
                      "runId",
                      "checkedAt",
                      "inputs",
                      "result",
                      "environment",
                      "report"
                    ]
                  }
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "checkedAt",
                "inputFingerprint",
                "evidence",
                "reason"
              ]
            }
          },
          "retired": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "ruleId",
          "category",
          "skill",
          "scope",
          "severity",
          "method",
          "summary",
          "status",
          "checkedAt",
          "inputFingerprint",
          "evidence",
          "reason",
          "notes"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "catalogVersion",
    "projectId",
    "items"
  ]
}
